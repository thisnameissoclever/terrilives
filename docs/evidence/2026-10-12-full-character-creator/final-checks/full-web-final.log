+       .radial-close { position: fixed; width: 44px; height: 44px; pointer-events: auto; border: 0; background: transparent; color: var(--hud-muted); font: inherit; }
+       #object-menu.object-menu-radial .menu-entry:focus-visible { outline: 2px solid var(--need-fill); outline-offset: 2px; }
