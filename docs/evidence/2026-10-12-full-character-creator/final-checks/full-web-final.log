+       .object-identity summary:focus-visible { outline: 2px solid var(--hud-text); outline-offset: 3px; }
+       .object-model { display: flex; align-items: center; gap: 10px; color: var(--hud-muted); font-size: 12px; }
+       .object-description-arrow { margin-left: auto; font-size: 18px; width: 20px; height: 20px; line-height: 1; display: inline-flex; align-items: center; justify-content: center; flex: none; }
+       .object-identity[open] .object-description-arrow { transform: rotate(90deg); }
+       .object-type { display: block; font-size: 15px; line-height: 1.4; }
+       .object-description { margin: 8px 0 2px; font-size: 13px; line-height: 1.5; max-width: 28ch; }
+       #object-menu { max-height: calc(100dvh - 16px); overflow-y: auto; }
+       #object-menu.object-menu-radial {
+         inset: 0; width: 0; height: 0; min-width: 0; max-width: none;
+         padding: 0; border: 0; background: transparent; box-shadow: none;
+         overflow: visible; pointer-events: none;
