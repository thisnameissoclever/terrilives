+    #[test]
+    fn the_shipped_shower_carries_a_presentation_only_tray_socket() {
+        let original = pack();
+        let id = original.find("shower").unwrap();
+        let object = original.object(id);
+        let action = object
+            .interactions
+            .iter()
+            .find(|it| it.id == "take_shower")
+            .unwrap();
+        let visual = action.visual.expect("shower use has a fitted visual");
+        assert_eq!(visual.action, CompiledVisualAction::Shower);
+        assert_eq!(visual.anchor, CompiledVisualAnchor::ObjectSocket);
+        assert_eq!(visual.facing, CompiledVisualFacing::Socket);
+        assert_eq!(visual.socket, Some(0));
+        assert_eq!(object.action_sockets.len(), 1);
+        assert_eq!(object.action_sockets[0].id, "tray");
+        assert_eq!(
+            (object.action_sockets[0].x, object.action_sockets[0].y),
+            (0.0, 0.0)
+        );
+        assert_eq!(
+            object.action_sockets[0].facing,
+            CompiledSocketFacing::PositiveX
+        );
+        assert_eq!((action.duration_ticks, action.slots), (45, 1));
+        let mut without_visual = original.clone();
+        without_visual.objects[id.0 as usize].interactions[0].visual = None;
+        without_visual.objects[id.0 as usize].action_sockets.clear();
+        assert_eq!(
+            content_fingerprint(original),
+            content_fingerprint(&without_visual)
+        );
+    }
