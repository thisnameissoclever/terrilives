/target
# Any sibling build directory. A review agent created `target-review/` with a
# separate CARGO_TARGET_DIR and 1 510 build artifacts went into a commit,
# including two 80 MB rlibs, because `git add -A` does not ask questions.
target-*/
node_modules/
web/src/wasm/
web/dist/
.superpowers/
mutants.out/
mutants.out.old/
assets/vendor/
.vs/
# Local self-signed TLS material for LAN HTTPS. Private keys never
# enter history, even throwaway dev ones - regenerate with the openssl
# one-liner in web/vite.config.ts.
web/.cert/

# Playwright MCP session artifacts (screenshots, console logs)
.playwright-mcp/
career-*.jpeg

# Python bytecode from the sprite generator. There was no Python in this
# repository until assets/sprites/gen/ replaced the PowerShell atlas build,
# so nothing had ever ignored it.
__pycache__/
*.pyc

# Reproducible full-resolution Sim renders remain local. Keep review sheets,
# animation loops, native exports, editable sources and validation results.
assets/models/sims/sim-01/review/*.png
!assets/models/sims/sim-01/review/*contact*.png
assets/models/sims/sim-01/review/pilot-v1/
assets/models/sims/sim-01/review/saved-rig-replay/
assets/models/sims/sim-01/build-status.json
assets/models/sims/sim-01/review/shirt-variants/blue/
assets/models/sims/sim-01/review/shirt-variants/red/
assets/models/sims/sim-01/review/shirt-variants/native-preview/
assets/models/sims/sim-01/shirt-variants-*-status.json
assets/models/sims/sim-01/review/exercise/green/
assets/models/sims/sim-01/review/exercise/blue/
assets/models/sims/sim-01/review/exercise/red/
assets/models/sims/sim-01/review/exercise/native-preview/
assets/models/sims/sim-01/review/exercise/pilot-v1/
assets/models/sims/sim-01/review/exercise/pilot-v2/
assets/models/sims/sim-01/review/exercise/pilot-v3/
assets/models/sims/sim-01/exercise-*-status.json
*.blend1
# Disposable checkout of the staged release used for byte-preservation checks.
.tmp/release-index-check/
# Rejected furniture source snapshots are retained locally; keep their images
# and rejection records. The current candidate's editable sources are tracked.
assets/models/furniture/review/candidate-01/*.blend
assets/models/furniture/review/status.json
# Full-resolution production passes remain locally available for inspection.
# Track runtime exports, journals, contact proofs and GPU review images instead.
assets/models/furniture/review/contributions-01/*.png
