/target
# Any sibling build directory. A review agent created `target-review/` with a
# separate CARGO_TARGET_DIR and 1 510 build artifacts went into a commit,
# including two 80 MB rlibs, because `git add -A` does not ask questions.
target-*/
node_modules/
web/src/wasm/
web/dist/
.superpowers/
mutants.out/
mutants.out.old/
assets/vendor/
.vs/
# Local self-signed TLS material for LAN HTTPS. Private keys never
# enter history, even throwaway dev ones - regenerate with the openssl
# one-liner in web/vite.config.ts.
web/.cert/

# Local provider credentials and paid-run guardrails, such as the Tripo API
# key. Never commit: this repository is public. One worktree carried this rule
# as an uncommitted local edit, so every other checkout would have staged a
# .env without complaint.
.env
.env.*
!.env.example

# Playwright MCP session artifacts (screenshots, console logs)
.playwright-mcp/
career-*.jpeg

# Python bytecode from the sprite generator. There was no Python in this
# repository until assets/sprites/gen/ replaced the PowerShell atlas build,
# so nothing had ever ignored it.
__pycache__/
*.pyc

# Reproducible full-resolution Sim renders remain local. Keep review sheets,
# animation loops, native exports, editable sources and validation results.
assets/models/sims/sim-01/review/*.png
!assets/models/sims/sim-01/review/*contact*.png
assets/models/sims/sim-01/review/pilot-v1/
assets/models/sims/sim-01/review/saved-rig-replay/
assets/models/sims/sim-01/build-status.json
assets/models/sims/sim-01/review/shirt-variants/blue/
assets/models/sims/sim-01/review/shirt-variants/red/
assets/models/sims/sim-01/review/shirt-variants/native-preview/
assets/models/sims/sim-01/shirt-variants-*-status.json
assets/models/sims/sim-01/review/exercise/green/
assets/models/sims/sim-01/review/exercise/blue/
assets/models/sims/sim-01/review/exercise/red/
assets/models/sims/sim-01/review/exercise/native-preview/
assets/models/sims/sim-01/review/exercise/pilot-v1/
assets/models/sims/sim-01/review/exercise/pilot-v2/
assets/models/sims/sim-01/review/exercise/pilot-v3/
assets/models/sims/sim-01/exercise-*-status.json
*.blend1
# Local scratch: disposable checkouts, experiment outputs and raw provider
# logs. Anything worth keeping as evidence is copied into
# docs/assets/review-evidence/ first, without account balances or provider
# identifiers.
.tmp/
web/proofs/.covered-bed-reference.json
.scratch/
assets/models/sims/sim-01/domestic-status.json
assets/models/sims/sim-01/export/domestic/*/raw-*.png
assets/models/sims/sim-01/export/domestic/*/render-manifest.json
# Rejected furniture source snapshots are retained locally; keep their images
# and rejection records. The current candidate's editable sources are tracked.
assets/models/furniture/review/candidate-01/*.blend
assets/models/furniture/review/status.json
assets/models/domestic/cleanup/*/*.png
assets/models/domestic/cleanup/*/manifest.json
# Full-resolution production passes remain locally available for inspection.
# Track runtime exports, journals, contact proofs and GPU review images instead.
assets/models/furniture/review/contributions-01/*.png
# Keep full-resolution bunk contributions locally, as for the other furniture.
# CI validates the accepted export receipt and runtime bytes, not fresh renders.
assets/models/bedroom/owner-review-pending/bunk/candidate-02/contributions-*/*.png
assets/models/bedroom/owner-review-pending/bunk/candidate-02/contribution-pilot/*.png
assets/models/bedroom/owner-review-pending/bunk/candidate-03/contributions-*/*.png
assets/models/bedroom/owner-review-pending/bunk/candidate-01/*.blend
# Full-size covered double-bed passes remain local; retain their hash-linked journal.
assets/models/bedroom/owner-review-pending/double-bed/candidate-03/contributions-01/*.png
assets/models/office/owner-review-pending/office-chair/candidate-01/*.blend
assets/models/office/owner-review-pending/office-chair/candidate-02/*.blend
# Keep rejected chair originals and notes, but only the accepted editable model.
assets/models/living/owner-review-pending/armchair/candidate-01/*.blend
assets/models/living/owner-review-pending/armchair/candidate-02/*.blend
# Full-size reciprocal passes remain local; track their receipt and runtime export.
assets/models/living/owner-review-pending/armchair/candidate-03/contributions-01/*.png
# Rejected aquarium models stay local; retain rejected images and receipts.
assets/models/living/owner-review-pending/aquarium/rejected/**/*.blend

# Full-resolution dining bakes; runtime frames and receipts are tracked.
assets/models/domestic/dining/*/*.png
assets/models/domestic/dining/*/manifest.json
dining-render.log
assets/models/domestic/seated-dining/*.png
assets/models/domestic/seated-dining/.checkpoints/
assets/models/domestic/seated-meal/*.png
assets/models/domestic/seated-meal/.checkpoints/
assets/models/domestic/seated-table/*.png
assets/models/domestic/seated-table/.checkpoints/
web/public/review-dining.sav
assets/models/domestic/seated-hands/*.png
assets/models/domestic/seated-hands/.checkpoints/
web/proofs/.covered-bunk-reference.json

# Cleaning animation raw renders and rejected previews stay local.
assets/models/cleaning/raw/
assets/models/cleaning/preview-*/
assets/models/cleaning/contacts/

# Local gate logs and work queue; never published.
.local-build/
